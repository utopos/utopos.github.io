---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { getExternalHost, getPostHref } from "@/utils/getPostHref";
import { toTransitionName } from "@/utils/toTransitionName";
import Datetime from "./Datetime.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";
import { slugifyStr } from "@/utils/slugify";

type Props = {
  variant?: "h2" | "h3";
  /** Show the post's local cover image above the title (used for featured posts). */
  showCover?: boolean;
  /** Keep the title marker on, not just on hover (used for featured posts). */
  marked?: boolean;
} & CollectionEntry<"posts">;

const {
  variant: Heading = "h2",
  showCover = false,
  marked = false,
  id,
  data,
} = Astro.props;

const { title, description, ...props } = data;
// Untagged posts default to "others"; don't show that placeholder.
const tags = (data.tags ?? []).filter(tag => tag !== "others");

const locale = Astro.currentLocale ?? config.site.lang;
const externalHost = getExternalHost(Astro.props);
const href = getPostHref(Astro.props, Astro.currentLocale);
const linkTarget = externalHost && { target: "_blank", rel: "noopener" };

// Only local images can be optimized; remote/string OG images are skipped.
const cover =
  showCover && data.ogImage && typeof data.ogImage !== "string"
    ? data.ogImage
    : undefined;
---

<li
  class="border-border mt-6 border-b border-dashed pb-6 last:border-b-0 last:pb-0"
>
  {
    cover && (
      // Decorative duplicate of the title link, hidden from keyboard and screen readers.
      <a href={href} {...linkTarget} tabindex="-1" aria-hidden="true">
        <Image
          src={cover}
          alt=""
          widths={[640, 1000]}
          sizes="(min-width: 768px) 736px, 100vw"
          class="border-border mb-3 aspect-video w-full rounded-md border object-cover transition-opacity hover:opacity-90"
        />
      </a>
    )
  }
  <a
    href={href}
    {...linkTarget}
    class="text-foreground inline-block text-lg font-bold"
  >
    <Heading transition:name={toTransitionName(id)}>
      <span class="title-marker" data-marked={marked || undefined}>{title}</span
      >
      {externalHost && <span class="sr-only">(opens on {externalHost})</span>}
    </Heading>
  </a>
  <div class="flex flex-wrap items-center gap-x-3">
    <Datetime {...props} />
    {
      externalHost && (
        <span class="bg-muted text-muted-foreground rounded px-1.5 py-0.5 text-xs font-semibold">
          ↗ {externalHost}
        </span>
      )
    }
  </div>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <ul class="text-muted-foreground mt-1 flex flex-wrap text-sm">
        {tags.map(tag => (
          <li class="after:mx-2 after:content-['·'] last:after:content-none">
            <a
              href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
              class="hover:text-accent focus-visible:text-accent"
            >
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</li>
